# Copy to frontend/.env.local and fill in. Restart `npm run dev` after editing.

# Backend address (defaults to http://127.0.0.1:8000 when unset)
VITE_API_URL=http://127.0.0.1:8000

# Supabase: Project Settings -> API. Leave blank to run in guest-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
