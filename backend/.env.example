# Copy to backend/.env and fill in.
ANTHROPIC_API_KEY=

# Optional: live job search (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# Optional: retrieval for the copilot (see backend/ingest_rag.py).
# Leave any of these empty and the copilot answers without sources.
VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
